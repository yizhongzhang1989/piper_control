+TEST(PiperXDriverCppTest, PositionHoldTimeoutKeepsPositionWithoutModeSwitch) {
+  MockArm arm;
+  double now = 0.0;
+  const Vec6 kp{{17.0, 16.0, 15.0, 4.0, 3.0, 3.0}};
+  const Vec6 kd{{6.0, 6.0, 3.0, 0.6, 0.4, 0.1}};
+  Controller ctrl(arm, [&] { return now; }, std::nullopt, 1.0, std::nullopt,
+                  0.0, std::nullopt, 0.05, 0.02, 5.0, 0.0, 0.08, 3.0, 0.0, kp, kd);
+  ctrl.position_hold_on_timeout = true;
+  ctrl.start_mit();
+  ASSERT_TRUE(ctrl.mit_target.has_value());
+  const auto startup = ctrl.mit_target->position;
+  arm.pos_[1] += 0.02;
+  now = 1.0;
+  ctrl.watchdog(false);
+  EXPECT_EQ(ctrl.mit_target->position, startup);
+
+  MitTarget command = *ctrl.mit_target;
+  command.position[0] += 0.01;
+  command.velocity.fill(0.1);
+  command.torque.fill(0.2);
+  ctrl.mit(command);
+  ctrl.watchdog(false);
+  const auto gravity_before = ctrl.gravity;
+  arm.calls.clear();
+  arm.pos_[2] -= 0.03;
+  now += 1.0;
+  ctrl.watchdog(false);
+  ASSERT_TRUE(arm.mit_out_.has_value());
+  EXPECT_EQ(ctrl.mit_target->position, command.position);
+  EXPECT_EQ(ctrl.mit_target->kp, command.kp);
+  EXPECT_EQ(ctrl.mit_target->kd, command.kd);
+  EXPECT_EQ(arm.mit_out_->velocity, Vec6{});
+  EXPECT_EQ(ctrl.mit_target->torque, Vec6{});
+  EXPECT_NE(ctrl.gravity, gravity_before);
+  EXPECT_EQ(arm.calls, std::vector<std::string>{"mit"});
+  now += 10.0;
+  ctrl.watchdog(false);
+  EXPECT_EQ(ctrl.mit_target->position, command.position);
+  command.position[0] += 0.01;
+  ctrl.mit(command);
+  ctrl.watchdog(false);
+  EXPECT_EQ(arm.mit_out_->velocity, command.velocity);
+}
